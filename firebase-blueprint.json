{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Ledger entry for revenue, expense, internal transfer, or settlement",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["revenue", "expense", "transfer", "debt_payment"] },
        "date": { "type": "string", "maxLength": 10 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "accountId": { "type": "string", "maxLength": 128 },
        "toAccountId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["completed", "partial", "pending"] },
        "partyType": { "type": "string", "enum": ["customer", "supplier", "none"] },
        "partyName": { "type": "string", "maxLength": 150 },
        "partyPhone": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "date", "title", "amount", "paidAmount"]
    },
    "Party": {
      "title": "Party",
      "description": "Customer or supplier record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["customer", "supplier"] },
        "phone": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type"]
    },
    "FinancialAccount": {
      "title": "FinancialAccount",
      "description": "Treasury cash drawer, bank account, or electronic wallet",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["cash", "bank", "wallet"] },
        "initialBalance": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type"]
    }
  },
  "firestore": {
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "All financial transactions for this user"
    },
    "/users/{userId}/parties/{partyId}": {
      "schema": { "$ref": "#/entities/Party" },
      "description": "Customer and supplier records for this user"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/FinancialAccount" },
      "description": "Financial accounts and treasuries for this user"
    }
  }
}
